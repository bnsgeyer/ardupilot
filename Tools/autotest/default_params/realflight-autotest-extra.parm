SIM_RFL_OPTS,9        # Reset vehicle on start | Don't print frame rate stats
RC_PROTOCOLS,0x40000  # Only accept UDP RC input
TERRAIN_ENABLE,0      # No terrain source here, and RealFlight scenery is not SRTM
RC1_TRIM,1500         # The harness's sticks centre on 1500, whatever transmitter the tune was calibrated with
RC2_TRIM,1500
RC3_TRIM,1500
RC4_TRIM,1500
RC1_REVERSED,0
RC2_REVERSED,0
RC3_REVERSED,0
RC4_REVERSED,0
